{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && (npm run seed:wait &) && firebase emulators:start --only functions,firestore,auth",
    "seed": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node --env-file=.env.local scripts/pull-seed-data.mjs",
    "seed:wait": "for i in $(seq 1 60); do if curl -sf http://127.0.0.1:8080 >/dev/null 2>&1; then npm run seed; exit 0; fi; sleep 1; done; echo 'seed:wait: timed out waiting for Firestore emulator on :8080' >&2; exit 1",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@qualdesk/firestore-big-batch": "^0.0.2",
    "dayjs": "^1.11.18",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.2.1",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.7.3"
  },
  "private": true
}
